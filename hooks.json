{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/agent-tooling/hooks/pre-session-update-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/clickup-plans/scripts/clickup-plan-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
